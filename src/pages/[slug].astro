---
import PageView from '../components/PageView.astro';
import { pages } from '../data/types';
import { HIDDEN_PAGES } from '../config';

export function getStaticPaths() {
  return Object.values(pages)
    .filter((p) => p.slug !== 'inicio')
    .filter((p) => !HIDDEN_PAGES.includes(p.slug))
    .map((p) => ({ params: { slug: p.slug }, props: { page: p } }));
}
const { page } = Astro.props;
---
<PageView page={page} />
