---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Split from '../components/Split.astro';
import WhyUs from '../components/WhyUs.astro';
import CardGrid from '../components/CardGrid.astro';
import CTA from '../components/CTA.astro';
import { SERVICES } from '../config';
const others = SERVICES.filter((s) => s.href !== '/evaluacion-psicologica/');
---
<Layout title="Evaluación psicológica" description="Evaluación psicológica con aplicación de pruebas para conocer tu estado emocional y orientar el proceso terapéutico. Cali y virtual." image="/images/2024-01-consejero-tomando-notas-ademas-mujer.jpg">
  <Hero title="Evaluación psicológica" subtitle="Conocer con claridad para acompañar mejor" bg="/images/2024-01-vista-frontal-psicologo-que-consulta-paciente_23-2148567328.jpg" />

  <Split img="/images/2024-01-trabajadores-alegres-lluvia-ideas_23-2147727609.jpg">
    <span class="kicker">¿En qué consiste?</span>
    <h2>Una mirada más precisa de tu estado emocional</h2>
    <p>La evaluación psicológica consiste en la aplicación de pruebas psicológicas que, junto con la conversación clínica, permiten conocer con más claridad tu estado emocional.</p>
    <p>Sus resultados ayudan a comprender mejor lo que estás viviendo y a orientar el proceso terapéutico de la forma más adecuada para ti.</p>
  </Split>

  <WhyUs
    kicker="El proceso"
    title="Cómo se desarrolla"
    items={[
      { icon: 5, title: 'Entrevista inicial', text: 'Conversamos sobre lo que te trae a consulta y lo que quieres comprender.' },
      { icon: 4, title: 'Aplicación de pruebas', text: 'Aplico las pruebas psicológicas adecuadas según tu caso.' },
      { icon: 0, title: 'Devolución de resultados', text: 'Te explico los resultados con claridad y definimos juntos los siguientes pasos.' },
    ]}
  />

  <CardGrid eyebrow="Otros servicios" title="También te puedo acompañar con" items={others} />

  <CTA title="¿Quieres hacer una evaluación?" text="Escríbeme y te cuento cómo podemos empezar." button="Escríbeme" />
</Layout>
