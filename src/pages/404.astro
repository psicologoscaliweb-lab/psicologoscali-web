---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Página no encontrada" noindex>
  <section class="section">
    <div class="wrap center">
      <span class="kicker">Error 404</span>
      <h1>No encontramos esta página</h1>
      <p class="lead">Puede que el enlace haya cambiado. Puedes volver al inicio o escribirme.</p>
      <p><a class="btn" href="/">Volver al inicio</a> <a class="btn btn--outline" href="/contactanos/">Contacto</a></p>
    </div>
  </section>
</Layout>
