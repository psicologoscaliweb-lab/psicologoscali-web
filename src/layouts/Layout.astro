---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { SITE } from '../config';

interface Props { title: string; description?: string; image?: string | null; noindex?: boolean }
const { title, description, image, noindex = false } = Astro.props;
const fullTitle = title === SITE.name ? `${SITE.name} | ${SITE.role} en Cali` : `${title} | ${SITE.name}`;
const desc = description ?? `${SITE.name}, ${SITE.role.toLowerCase()} en Cali. Psicoterapia individual para adultos, talleres de autocuidado y círculo de mujeres. Presencial y virtual.`;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImage = new URL(image ?? '/og.jpg', SITE.url).href;
const tawkId = import.meta.env.PUBLIC_TAWK_ID; // ej: "64ab.../1h5..." (opcional)
---
<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#7b1fa2" />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: SITE.name,
      jobTitle: SITE.role,
      url: SITE.url,
      image: SITE.url + '/images/yolima-ospina.jpg',
      telephone: '+57 ' + SITE.phone,
      alumniOf: 'Universidad de San Buenaventura Cali',
      address: { '@type': 'PostalAddress', addressLocality: 'Cali', addressCountry: 'CO' },
    })} />
  </head>
  <body>
    <a class="skip" href="#main">Saltar al contenido</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <WhatsAppButton />
    <script is:inline>
      // Revela los bloques al entrar en pantalla
      (function () {
        var els = document.querySelectorAll('[data-reveal]');
        if (!('IntersectionObserver' in window)) { els.forEach(function (e) { e.classList.add('in'); }); return; }
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (en) { if (en.isIntersecting) { en.target.classList.add('in'); io.unobserve(en.target); } });
        }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
        els.forEach(function (e) { io.observe(e); });
      })();
    </script>
    <script is:inline>
      // Si una imagen aún no está en /public/images, se oculta y queda el fondo de color.
      document.querySelectorAll('img').forEach(function (i) {
        function hide() { i.style.visibility = 'hidden'; }
        if (i.complete && !i.naturalWidth) hide(); else i.addEventListener('error', hide);
      });
    </script>
    {tawkId && (
      <script is:inline define:vars={{ tawkId }}>
        var Tawk_API = Tawk_API || {};
        (function () {
          var s = document.createElement('script');
          s.async = true; s.src = 'https://embed.tawk.to/' + tawkId; s.charset = 'UTF-8';
          s.setAttribute('crossorigin', '*');
          document.body.appendChild(s);
        })();
      </script>
    )}
  </body>
</html>

<style is:global>
  .skip { position: absolute; left: -9999px; }
  .skip:focus { left: 16px; top: 16px; z-index: 100; background: #fff; padding: 8px 12px; }
</style>
