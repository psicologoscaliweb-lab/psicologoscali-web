---
interface Props { items: { title: string; text: string }[] }
const { items } = Astro.props;
---
<section class="section section--green">
  <div class="wrap">
    <div class="center">
      <span class="eyebrow">Nuestro enfoque</span>
      <h2>Por qué escogernos</h2>
    </div>
    <div class="grid">
      {items.map((it, i) => (
        <article>
          <span class="num">0{i + 1}</span>
          <h3>{it.title}</h3>
          <p>{it.text.replace('atención una continua', 'una atención continua')}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-top: 40px; }
  article { padding: 28px; border: 1px solid rgba(255,255,255,0.14); border-radius: var(--radius); background: rgba(255,255,255,0.04); }
  .num { font-family: var(--serif); font-size: 2rem; color: #f0c9b4; }
  p { margin: 0; color: #c9d6d0; }
  @media (max-width: 900px) { .grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) { .grid { grid-template-columns: 1fr; } }
</style>
