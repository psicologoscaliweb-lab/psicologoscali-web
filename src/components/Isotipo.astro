---
// Isotipo de la marca: "Y" con alas de mariposa (recreación vectorial del manual de marca).
// variant: "color" (fondos claros) | "white" (fondos oscuros) | "wings" (solo la mariposa, decorativa)
interface Props { variant?: 'color' | 'white' | 'wings'; size?: number | string; class?: string; title?: string }
const { variant = 'color', size = 64, class: cls, title } = Astro.props;
const yFill = variant === 'white' ? '#ffffff' : 'var(--brand-y, #6a1b9a)';
const up = variant === 'white' ? '#c9b3e6' : '#b39ddb';
const hl = variant === 'white' ? '#efe4fa' : '#ddcdf2';
const lo = variant === 'white' ? '#dccaf1' : '#c9b3e6';
const id = 'w' + Math.random().toString(36).slice(2, 8);
---
<svg class={cls} width={size} viewBox="-4 30 248 150" role={title ? 'img' : undefined} aria-label={title} aria-hidden={title ? undefined : 'true'} xmlns="http://www.w3.org/2000/svg">
  <g id={id}>
    <path d="M84 122 C62 128 14 122 10 90 C8 74 22 68 36 70 C58 74 78 94 84 122 Z" fill={up} />
    <path d="M8 80 C10 62 30 56 48 60 C66 64 82 82 86 106 C78 88 62 74 46 70 C30 66 16 70 8 80 Z" fill={hl} />
    <path d="M82 130 C68 132 52 142 48 168 C64 170 80 158 86 138 Z" fill={lo} />
  </g>
  <use href={'#' + id} transform="translate(240 0) scale(-1 1)" />
  {variant !== 'wings' && <path d="M694 676V651Q645 644 626 612L435 301V117Q435 62 450.5 46.5Q466 31 527 25V0H180V25Q241 31 257.0 46.5Q273 62 273 117V264L90 596Q59 648 10 651V676H345V651L320 650Q289 650 276.5 643.0Q264 636 264 620Q264 610 269.0 598.5Q274 587 280.5 576.0Q287 565 288 561L408 329L519 514Q558 578 558 609Q558 631 541.0 639.0Q524 647 474 651V676Z" fill={yFill} transform="translate(49.6 176) scale(0.2 -0.2)" />}
</svg>
