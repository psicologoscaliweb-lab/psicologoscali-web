---
import { NAV, SITE, isVisibleHref } from '../config';
const path = Astro.url.pathname;
const nav = NAV.map((item) => ({
  ...item,
  children: item.children?.filter((c) => isVisibleHref(c.href)),
}));
const isActive = (item: (typeof nav)[number]) =>
  item.href === path || item.children?.some((c) => c.href === path);
---
<header class="header">
  <div class="wrap bar">
    <a href="/" class="brand" aria-label={`${SITE.name}, inicio`}>
      <span class="mono" aria-hidden="true">YO</span>
      <span><strong>{SITE.name}</strong><small>{SITE.role}</small></span>
    </a>

    <button class="toggle" aria-expanded="false" aria-controls="menu" aria-label="Abrir menú">
      <span></span><span></span><span></span>
    </button>

    <nav id="menu" class="menu" aria-label="Principal">
      <ul>
        {nav.map((item) => (
          <li class:list={[{ 'has-sub': item.children, active: isActive(item) }]}>
            {item.href ? <a href={item.href}>{item.label}</a> : <button type="button" class="sub-btn">{item.label}</button>}
            {item.children && (
              <ul class="sub">
                {item.children.map((c) => <li><a href={c.href} aria-current={c.href === path ? 'page' : undefined}>{c.label}</a></li>)}
              </ul>
            )}
          </li>
        ))}
      </ul>
      <a class="btn cta" href="/contactanos/">Agenda tu cita</a>
    </nav>
  </div>
</header>

<script>
  const t = document.querySelector<HTMLButtonElement>('.toggle');
  const m = document.querySelector('.menu');
  t?.addEventListener('click', () => {
    const open = t.getAttribute('aria-expanded') === 'true';
    t.setAttribute('aria-expanded', String(!open));
    m?.classList.toggle('open', !open);
  });
  document.querySelectorAll<HTMLButtonElement>('.sub-btn').forEach((b) =>
    b.addEventListener('click', () => b.parentElement?.classList.toggle('expanded')),
  );
</script>

<style>
  .header { position: sticky; top: 0; z-index: 50; background: rgba(252, 248, 255, 0.9); backdrop-filter: blur(8px); border-bottom: 1px solid var(--line); }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 24px; min-height: 76px; }
  .brand { display: flex; align-items: center; gap: 12px; text-decoration: none; color: var(--navy); }
  .mono { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; background: var(--grad); color: #fff; font-weight: 600; font-size: 0.95rem; letter-spacing: 0.04em; box-shadow: 0 8px 18px -8px rgba(123,63,184,0.8); }
  .brand strong { display: block; font-size: 1.15rem; font-weight: 700; line-height: 1.1; background: var(--grad); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .brand small { display: block; font-size: 0.8rem; color: var(--muted); letter-spacing: 0.02em; }
  .menu { display: flex; align-items: center; gap: 28px; }
  .menu > ul { display: flex; gap: 6px; list-style: none; margin: 0; padding: 0; }
  .menu li { position: relative; }
  .menu a, .sub-btn { display: block; padding: 10px 12px; font: 500 0.93rem var(--font); color: var(--ink); text-decoration: none; background: none; border: 0; cursor: pointer; border-radius: 8px; }
  .menu > ul > li.active > a, .menu > ul > li.active > .sub-btn { color: var(--purple); background: var(--lilac); }
  .menu a:hover, .sub-btn:hover { color: var(--purple); }
  .has-sub > a::after, .has-sub > .sub-btn::after { content: ' ▾'; font-size: 0.75em; }
  .sub { position: absolute; top: 100%; left: 0; min-width: 240px; list-style: none; margin: 0; padding: 8px; background: var(--white); border-radius: 12px; box-shadow: var(--shadow); opacity: 0; visibility: hidden; transform: translateY(6px); transition: 0.18s; }
  .has-sub:hover .sub, .has-sub:focus-within .sub { opacity: 1; visibility: visible; transform: none; }
  .sub a[aria-current] { color: var(--purple); background: var(--lilac); }
  .sub a:hover { background: var(--lilac); }
  .cta { padding: 0.7em 1.3em; }
  .toggle { display: none; background: none; border: 0; padding: 10px; cursor: pointer; }
  .toggle span { display: block; width: 24px; height: 2px; margin: 5px 0; background: var(--navy); transition: 0.2s; }

  @media (max-width: 980px) {
    .toggle { display: block; }
    .menu { position: fixed; inset: 76px 0 auto 0; flex-direction: column; align-items: stretch; gap: 12px; padding: 16px; background: var(--lilac-bg); border-bottom: 1px solid var(--line); max-height: calc(100vh - 76px); overflow-y: auto; display: none; }
    .menu.open { display: flex; }
    .menu > ul { flex-direction: column; }
    .sub { position: static; opacity: 1; visibility: visible; transform: none; box-shadow: none; padding: 0 0 0 14px; display: none; background: none; }
    .has-sub.expanded .sub, .has-sub:has(> a) .sub { display: block; }
    .cta { justify-content: center; }
  }
</style>
