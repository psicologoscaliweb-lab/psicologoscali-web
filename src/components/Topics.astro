---
// Lista de motivos de consulta en forma de etiquetas.
interface Props { kicker?: string; title: string; intro?: string; items: string[] }
const { kicker, title, intro, items } = Astro.props;
---
<section class="section">
  <div class="wrap">
    <div class="center" data-reveal="up">
      {kicker && <span class="kicker">{kicker}</span>}
      <h2>{title}</h2>
      {intro && <p class="lead">{intro}</p>}
    </div>
    <ul class="chips" data-reveal="up">
      {items.map((t) => <li>{t}</li>)}
    </ul>
  </div>
</section>

<style>
  .chips { list-style: none; padding: 0; margin: 40px auto 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; max-width: 900px; }
  li { padding: 12px 22px; border-radius: 999px; background: var(--white); border: 1px solid var(--line); color: var(--navy); font-weight: 500; box-shadow: 0 2px 0 var(--line); }
  li::before { content: ''; display: inline-block; width: 8px; height: 8px; margin-right: 10px; border-radius: 50%; background: var(--grad); vertical-align: middle; }
</style>
