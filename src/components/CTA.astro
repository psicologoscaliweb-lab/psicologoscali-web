---
import { wa } from '../config';
interface Props { title: string; text: string; button?: string; message?: string }
const { title, text, button = 'Escríbeme para agendar', message } = Astro.props;
const href = wa(message);
---
<section class="cta-wrap">
  <div class="wrap">
    <div class="box" data-reveal="zoom">
      <span class="ring r1" aria-hidden="true"></span>
      <span class="ring r2" aria-hidden="true"></span>
      <div class="txt">
        <h2>{title}</h2>
        <p>{text}</p>
      </div>
      <a class="btn btn--light" href={href} target="_blank" rel="noopener">{button}</a>
    </div>
  </div>
</section>

<style>
  .cta-wrap { padding-block: 0 clamp(64px, 9vw, 110px); }
  .box { position: relative; overflow: hidden; display: flex; align-items: center; justify-content: space-between; gap: 28px; flex-wrap: wrap; padding: clamp(36px, 6vw, 64px); border-radius: 32px; background: var(--grad); color: #fff; box-shadow: var(--shadow); }
  .txt { position: relative; max-width: 620px; }
  h2 { color: #fff; margin-bottom: 0.3em; }
  p { margin: 0; color: #eadff7; font-size: 1.08rem; font-weight: 300; }
  .btn { position: relative; }
  .ring { position: absolute; border-radius: 50%; border: 2px solid rgba(255,255,255,0.18); }
  .r1 { width: 340px; height: 340px; right: -90px; top: -140px; }
  .r2 { width: 220px; height: 220px; right: 120px; bottom: -150px; border-color: rgba(255,255,255,0.12); }
</style>
