---
interface Props { title: string; text: string; button?: string }
const { title, text, button = 'Contáctanos' } = Astro.props;
---
<section class="section">
  <div class="wrap">
    <div class="box">
      <div>
        <h2>{title}</h2>
        <p>{text}</p>
      </div>
      <a class="btn" href={Astro.url.pathname === '/contactanos/' ? '#contact-form' : '/contactanos/'}>{button}</a>
    </div>
  </div>
</section>

<style>
  .section { padding-top: 0; }
  .box { display: flex; align-items: center; justify-content: space-between; gap: 28px; flex-wrap: wrap; padding: clamp(32px, 5vw, 56px); border-radius: 28px; background: var(--green-100); }
  h2 { margin-bottom: 0.3em; }
  p { margin: 0; color: var(--muted); font-size: 1.1rem; }
</style>
