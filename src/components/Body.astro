---
import type { Block } from '../data/types';
import Accordion from './Accordion.astro';

interface Props { blocks: Block[]; image?: string | null }
const { blocks, image } = Astro.props;

// Agrupa los bloques en secciones: cada título abre una sección nueva.
type Group = { eyebrow?: string; title?: string; paras: string[]; imgs: string[]; acc?: { q: string; a: string }[]; btn?: { text: string; href: string } };
const groups: Group[] = [];
let cur: Group | null = null;
for (const b of blocks) {
  if (b.type === 'h' || !cur) {
    cur = { paras: [], imgs: [] };
    groups.push(cur);
    if (b.type === 'h') { cur.title = b.text; cur.eyebrow = b.eyebrow; continue; }
  }
  if (b.type === 'p') cur.paras.push(...b.text.split('\n'));
  else if (b.type === 'img') cur.imgs.push(b.value);
  else if (b.type === 'acc') cur.acc = b.value;
  else if (b.type === 'btn') cur.btn = b.value;
}
// Una imagen suelta antes del primer título (ej. foto de perfil) va con la primera sección de texto.
if (groups.length > 1 && !groups[0].title && !groups[0].paras.length && groups[0].imgs.length) {
  groups[1].imgs.unshift(...groups[0].imgs);
  groups.shift();
}
// "Qué es?" -> "¿Qué es?"
const fix = (t?: string) => (t === 'Qué es?' ? '¿Qué es?' : t);
// Si la primera sección no tiene imágenes, usamos la del encabezado para darle aire.
if (image && groups[0] && !groups[0].imgs.length && !groups[0].acc) groups[0].imgs.push(image);
---
<div class="body">
  {groups.map((g, i) => (
    <section class:list={['section', { 'section--sand': i % 2 === 1 }]}>
      <div class:list={['wrap', 'g', { split: g.imgs.length && !g.acc, rev: i % 2 === 1 }]}>
        <div class="text">
          {g.eyebrow && <span class="eyebrow">{g.eyebrow}</span>}
          {g.title && <h2>{fix(g.title)}</h2>}
          {g.paras.map((p) => <p>{p}</p>)}
          {g.btn && <a class="btn btn--outline" href={g.btn.href}>{g.btn.text}</a>}
        </div>
        {g.acc && <div class="accw"><Accordion items={g.acc} /></div>}
        {g.imgs.length > 0 && !g.acc && (
          <div class:list={['imgs', `n${Math.min(g.imgs.length, 4)}`]}>
            {g.imgs.slice(0, 4).map((src) => <div class="ph"><img src={src} alt="" loading="lazy" /></div>)}
          </div>
        )}
      </div>
    </section>
  ))}
</div>

<style>
  .g { display: grid; gap: 48px; }
  .g:not(.split) .text { max-width: 760px; }
  .split { grid-template-columns: 1.1fr 1fr; align-items: center; }
  .split.rev .imgs { order: -1; }
  .text p { color: var(--muted); font-size: 1.06rem; }
  .text .btn { margin-top: 12px; }
  .accw { max-width: 860px; width: 100%; }
  .imgs { display: grid; gap: 14px; }
  .imgs .ph { border-radius: var(--radius); aspect-ratio: 4 / 3; }
  .imgs.n1 .ph { aspect-ratio: 4 / 5; max-height: 560px; }
  .imgs.n2 { grid-template-columns: 1fr 1fr; }
  .imgs.n2 .ph { aspect-ratio: 3 / 4; }
  .imgs.n2 .ph:last-child { margin-top: 40px; }
  .imgs.n3, .imgs.n4 { grid-template-columns: 1fr 1fr; }
  .imgs.n3 .ph:first-child { grid-column: span 2; aspect-ratio: 16 / 9; }
  @media (max-width: 860px) {
    .split { grid-template-columns: 1fr; }
    .split.rev .imgs { order: 0; }
    .imgs.n1 .ph { aspect-ratio: 4 / 3; }
  }
</style>
