---
interface Props { items: { q: string; a: string }[] }
const { items } = Astro.props;
const paras = (a: string) => a.split('\n').filter(Boolean);
---
<div class="acc">
  {items.map((it, i) => (
    <details open={i === 0}>
      <summary>{it.q}</summary>
      <div class="body">{paras(it.a).map((p) => <p>{p}</p>)}</div>
    </details>
  ))}
</div>

<style>
  .acc { display: grid; gap: 10px; }
  details { background: var(--white); border: 1px solid var(--line); border-radius: 16px; transition: border-color 0.3s, box-shadow 0.3s; }
  details[open] { border-color: var(--lilac-2); box-shadow: var(--shadow); }
  summary { list-style: none; cursor: pointer; padding: 18px 56px 18px 22px; font-weight: 600; color: var(--navy); position: relative; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; position: absolute; right: 18px; top: 50%; transform: translateY(-50%); display: grid; place-items: center; width: 30px; height: 30px; border-radius: 50%; background: var(--lilac); color: var(--purple); font-size: 1.3rem; font-weight: 400; line-height: 1; transition: transform 0.3s, background 0.3s, color 0.3s; }
  details[open] summary::after { background: var(--grad); color: #fff; }
  details[open] summary::after { transform: translateY(-50%) rotate(45deg); }
  .body { padding: 0 22px 8px; color: var(--muted); }
</style>
