---
// Encabezado de la página de inicio: presentación personal con su foto.
import { SITE } from '../config';
interface Props { title: string; subtitle: string }
const { title, subtitle } = Astro.props;
---
<section class="hero">
  <div class="orb o1" aria-hidden="true"></div>
  <div class="orb o2" aria-hidden="true"></div>
  <div class="wrap inner">
    <div class="txt">
      <p class="tag a1">{SITE.role} · {SITE.modality}</p>
      <h1 class="a2">{title}</h1>
      <p class="sub a3">{subtitle}</p>
      <div class="actions a4">
        <a class="btn btn--light" href="/contactanos/">Agenda tu cita</a>
        <a class="btn btn--ghost" href="/sobre-mi/">Conóceme</a>
      </div>
    </div>
    <figure class="photo a3">
      <div class="frame">
        <img src="/images/yolima-ospina.jpg" alt={`${SITE.name}, ${SITE.role}`} width="1005" height="1516" fetchpriority="high" />
      </div>
      <figcaption>
        <strong>{SITE.name}</strong>
        <span>Especialista en Psicología Clínica Psicoanalítica</span>
      </figcaption>
    </figure>
  </div>
  <svg class="wave" viewBox="0 0 1440 120" preserveAspectRatio="none" aria-hidden="true">
    <path fill="rgba(252,248,255,0.35)" d="M0 60c180 40 360 58 560 40S960 20 1160 26c120 4 210 22 280 40v54H0Z" />
    <path fill="#fcf8ff" d="M0 86c200-30 420-40 640-18s420 46 600 26c80-9 150-22 200-34v60H0Z" />
  </svg>
</section>

<style>
  .hero { position: relative; overflow: hidden; isolation: isolate; color: #fff; padding-block: 110px 170px; background: radial-gradient(120% 120% at 90% 10%, #9142c5 0%, #5a2a92 38%, var(--navy) 80%); }
  .orb { position: absolute; border-radius: 50%; filter: blur(70px); z-index: -1; }
  .o1 { width: 460px; height: 460px; right: 4%; top: -120px; background: #c27be8; opacity: 0.45; animation: float 16s ease-in-out infinite; }
  .o2 { width: 320px; height: 320px; left: -100px; bottom: -60px; background: #467ff7; opacity: 0.25; animation: float 20s ease-in-out infinite reverse; }
  @keyframes float { 50% { transform: translate(-30px, 30px) scale(1.08); } }

  .inner { display: grid; grid-template-columns: 1.15fr 0.85fr; gap: clamp(32px, 6vw, 80px); align-items: center; }
  .tag { display: inline-block; padding: 6px 16px; border-radius: 999px; background: rgba(255,255,255,0.14); border: 1px solid rgba(255,255,255,0.25); font-size: 0.88rem; font-weight: 500; }
  h1 { color: #fff; max-width: 16ch; }
  .sub { font-size: clamp(1.05rem, 1.7vw, 1.25rem); font-weight: 300; max-width: 46ch; color: #ece4f7; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 30px; }

  .photo { margin: 0; justify-self: center; width: min(380px, 100%); position: relative; }
  .frame { position: relative; aspect-ratio: 4 / 5; border-radius: 200px 200px 28px 28px; overflow: hidden; background: #fff; border: 6px solid rgba(255,255,255,0.9); box-shadow: 0 30px 60px -25px rgba(10,5,40,0.7); }
  .frame::after { content: ''; position: absolute; inset: -6px; border-radius: inherit; box-shadow: 0 0 0 10px rgba(194,123,232,0.25); pointer-events: none; }
  .frame img { width: 100%; height: 100%; object-fit: cover; object-position: center 18%; }
  figcaption { position: absolute; left: 50%; bottom: -26px; transform: translateX(-50%); width: max-content; max-width: 92%; padding: 12px 20px; border-radius: 16px; background: #fff; color: var(--navy); text-align: center; box-shadow: var(--shadow); }
  figcaption strong { display: block; font-size: 1rem; }
  figcaption span { display: block; font-size: 0.78rem; color: var(--purple); }
  .wave { position: absolute; left: 0; bottom: -1px; width: 100%; height: clamp(60px, 9vw, 120px); }

  .a1, .a2, .a3, .a4 { animation: rise 0.9s cubic-bezier(.2,.7,.2,1) both; }
  .a2 { animation-delay: 0.12s; } .a3 { animation-delay: 0.24s; } .a4 { animation-delay: 0.36s; }
  @keyframes rise { from { opacity: 0; transform: translateY(26px); } }

  @media (max-width: 860px) {
    .hero { padding-block: 90px 150px; }
    .inner { grid-template-columns: 1fr; }
    .photo { order: -1; width: min(280px, 80%); }
    .txt { text-align: center; }
    h1, .sub { margin-inline: auto; }
    .actions { justify-content: center; }
  }
</style>
