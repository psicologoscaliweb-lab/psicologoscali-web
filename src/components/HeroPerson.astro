---
// Encabezado de la página de inicio: presentación personal con su foto.
import { SITE, wa } from '../config';
import Isotipo from './Isotipo.astro';
interface Props { title: string }
const { title } = Astro.props;
---
<section class="hero">
  <div class="orb o1" aria-hidden="true"></div>
  <div class="orb o2" aria-hidden="true"></div>
  <Isotipo variant="white" class="hero-mark" />
  <div class="wrap inner">
    <div class="txt">
      <p class="tag a1">{SITE.modality}</p>
      <h1 class="a2">{title}</h1>
      <div class="sub a3"><slot /></div>
      <div class="actions a4">
        <a class="btn btn--light" href={wa()} target="_blank" rel="noopener">Agenda tu espacio</a>
        <a class="btn btn--ghost" href="/sobre-mi/">Conóceme</a>
      </div>
    </div>
    <figure class="photo a3">
      <div class="frame">
        <img src="/images/yolima-recorte.webp" alt={`${SITE.name}, ${SITE.role}`} width="848" height="1058" fetchpriority="high" />
      </div>
      <figcaption>
        <Isotipo class="fiso" size={34} />
        <span class="fn"><strong>{SITE.name}</strong><span>Psicóloga</span></span>
      </figcaption>
    </figure>
  </div>
  <svg class="wave" viewBox="0 0 1440 120" preserveAspectRatio="none" aria-hidden="true">
    <path fill="rgba(252,248,255,0.35)" d="M0 60c180 40 360 58 560 40S960 20 1160 26c120 4 210 22 280 40v54H0Z" />
    <path fill="#fcf8ff" d="M0 86c200-30 420-40 640-18s420 46 600 26c80-9 150-22 200-34v60H0Z" />
  </svg>
</section>

<style>
  .hero { position: relative; overflow: hidden; isolation: isolate; color: #fff; padding-block: 110px 170px; background: radial-gradient(120% 120% at 90% 10%, #9c4dcc 0%, #5e1786 38%, var(--navy) 80%); }
  .orb { position: absolute; border-radius: 50%; filter: blur(70px); z-index: -1; }
  .o1 { width: 460px; height: 460px; right: 4%; top: -120px; background: #b39ddb; opacity: 0.45; animation: float 16s ease-in-out infinite; }
  .o2 { width: 320px; height: 320px; left: -100px; bottom: -60px; background: #8e6cd1; opacity: 0.25; animation: float 20s ease-in-out infinite reverse; }
  @keyframes float { 50% { transform: translate(-30px, 30px) scale(1.08); } }

  .inner { display: grid; grid-template-columns: 1.15fr 0.85fr; gap: clamp(32px, 6vw, 80px); align-items: center; }
  .tag { display: inline-block; padding: 6px 16px; border-radius: 999px; background: rgba(255,255,255,0.14); border: 1px solid rgba(255,255,255,0.25); font-size: 0.88rem; font-weight: 500; }
  h1 { color: #fff; max-width: 18ch; font-size: clamp(2rem, 4.2vw, 3.3rem); }
  .sub { font-size: clamp(1rem, 1.5vw, 1.12rem); font-weight: 300; max-width: 52ch; color: #ece4f7; }
  .sub :global(p) { margin: 0 0 0.8em; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 30px; }

  .photo { margin: 0; justify-self: center; width: min(380px, 100%); position: relative; }
  .frame { position: relative; aspect-ratio: 4 / 5; border-radius: 200px 200px 28px 28px; overflow: hidden; background: radial-gradient(90% 70% at 50% 35%, #ffffff 0%, #efe4f8 45%, #d9c4ee 100%); border: 6px solid rgba(255,255,255,0.9); box-shadow: 0 30px 60px -25px rgba(10,5,40,0.7); }
  .frame::after { content: ''; position: absolute; inset: -6px; border-radius: inherit; box-shadow: 0 0 0 10px rgba(179,157,219,0.25); pointer-events: none; }
  .frame img { width: 100%; height: 100%; object-fit: cover; object-position: center top; }
  figcaption { position: absolute; left: 50%; bottom: -30px; transform: translateX(-50%); width: max-content; max-width: 96%; display: flex; align-items: center; gap: 10px; padding: 10px 20px 10px 14px; border-radius: 18px; background: #fff; box-shadow: var(--shadow); }
  .fn { display: flex; flex-direction: column; align-items: center; line-height: 1.1; }
  .fn strong { font-family: 'Great Vibes', cursive; font-weight: 400; font-size: 1.6rem; color: var(--purple); }
  .fn span { font-size: 0.66rem; letter-spacing: 0.4em; padding-left: 0.4em; color: #9a7bc9; font-weight: 500; text-transform: uppercase; }
  :global(.hero-mark) { position: absolute; left: -60px; bottom: 40px; width: 520px; opacity: 0.07; z-index: -1; pointer-events: none; }
  .wave { position: absolute; left: 0; bottom: -1px; width: 100%; height: clamp(60px, 9vw, 120px); }

  .a1, .a2, .a3, .a4 { animation: rise 0.9s cubic-bezier(.2,.7,.2,1) both; }
  .a2 { animation-delay: 0.12s; } .a3 { animation-delay: 0.24s; } .a4 { animation-delay: 0.36s; }
  @keyframes rise { from { opacity: 0; transform: translateY(26px); } }

  @media (max-width: 860px) {
    .hero { padding-block: 90px 150px; }
    .inner { grid-template-columns: 1fr; }
    .photo { order: -1; width: min(280px, 80%); margin-bottom: 44px; }
    .txt { text-align: center; }
    h1, .sub { margin-inline: auto; }
    .actions { justify-content: center; }
  }
</style>
