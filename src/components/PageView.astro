---
import Layout from '../layouts/Layout.astro';
import Hero from './Hero.astro';
import Body from './Body.astro';
import WhyUs from './WhyUs.astro';
import CardGrid from './CardGrid.astro';
import Testimonials from './Testimonials.astro';
import CTA from './CTA.astro';
import ContactForm from './ContactForm.astro';
import { catalog, type Page } from '../data/types';
import { SITE } from '../config';

interface Props { page: Page }
const { page } = Astro.props;
const home = page.slug === 'inicio';
const desc = page.seo ?? page.hero.subtitle + '. ' + SITE.name + ' en Cali.';
---
<Layout title={home ? SITE.name : page.title} description={desc} image={page.hero.bg}>
  <Hero title={page.hero.title} subtitle={page.hero.subtitle} bg={page.hero.bg} home={home} />

  {page.form ? (
    <section class="section">
      <div class="wrap contact">
        <div>
          <span class="eyebrow">Escríbenos</span>
          <h2>Estamos para escucharte</h2>
          <p class="lead">Si quieres saber más sobre nuestros servicios, resolver tus dudas o solicitar una cita, escríbenos. Te responderemos lo antes posible.</p>
          <ul class="info">
            <li><span>Teléfono</span><a href={`tel:+57${SITE.phone.replace(/\s/g, '')}`}>{SITE.phone}</a></li>
            <li><span>WhatsApp</span><a href={`https://wa.me/${SITE.whatsapp}`} target="_blank" rel="noopener">Escríbenos directo</a></li>
            <li><span>Correo</span><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
          </ul>
        </div>
        <ContactForm />
      </div>
    </section>
  ) : (
    <Body blocks={page.body} />
  )}

  {page.showCatalog && <CardGrid eyebrow="Servicios" title="Encuentra el acompañamiento que necesitas" items={catalog} />}
  {page.team && <CardGrid eyebrow="Nuestro equipo" title="Conoce a nuestros profesionales" items={page.team} linkLabel="Ver perfil" />}
  {page.why && page.why.length > 0 && <WhyUs items={page.why} />}
  {page.services && (
    <CardGrid
      eyebrow={page.services.eyebrow === 'Servicios' ? 'Servicios' : 'Otros servicios'}
      title={page.services.title}
      items={page.services.items}
      showAll
    />
  )}
  {page.testimonials.length > 0 && <Testimonials items={page.testimonials} />}
  {page.cta && <CTA title={page.cta.title} text={page.cta.text} button={page.cta.button} />}
</Layout>

<style>
  .contact { display: grid; grid-template-columns: 1fr 1.1fr; gap: 56px; align-items: start; }
  .info { list-style: none; padding: 0; margin: 28px 0 0; display: grid; gap: 14px; }
  .info li { display: grid; gap: 2px; padding: 16px 20px; background: var(--white); border-radius: 14px; border: 1px solid var(--line); }
  .info span { font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--muted); }
  .info a { font-weight: 600; text-decoration: none; font-size: 1.05rem; }
  @media (max-width: 900px) { .contact { grid-template-columns: 1fr; } }
</style>
